{
  "entities": {
    "Scholarship": {
      "title": "Scholarship",
      "description": "International scholarship opportunity record",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "shortDescription": { "type": "string", "maxLength": 500 },
        "description": { "type": "string", "maxLength": 10000 },
        "providerId": { "type": "string", "maxLength": 100 },
        "providerName": { "type": "string", "maxLength": 200 },
        "universityId": { "type": "string", "maxLength": 100 },
        "universityName": { "type": "string", "maxLength": 200 },
        "countryId": { "type": "string", "maxLength": 100 },
        "countryName": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "degreeLevels": { "type": "array" },
        "fields": { "type": "array" },
        "studyMode": { "type": "string", "maxLength": 50 },
        "fundingType": { "type": "string", "maxLength": 50 },
        "benefits": { "type": "array" },
        "eligibility": { "type": "string", "maxLength": 5000 },
        "eligibleNationalities": { "type": "array" },
        "requirements": { "type": "array" },
        "requiredDocuments": { "type": "array" },
        "openingDate": { "type": "string", "maxLength": 50 },
        "deadline": { "type": "string", "maxLength": 50 },
        "applicationUrl": { "type": "string", "maxLength": 1000 },
        "officialUrl": { "type": "string", "maxLength": 1000 },
        "applicationInstructions": { "type": "string", "maxLength": 5000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "providerLogo": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "maxLength": 50 },
        "featured": { "type": "boolean" },
        "verified": { "type": "boolean" },
        "viewCount": { "type": "number" },
        "applicationClickCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["title", "slug", "universityName", "countryName", "fundingType", "status"]
    },
    "University": {
      "title": "University",
      "description": "Higher education institution offering scholarships",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "countryId": { "type": "string", "maxLength": 100 },
        "countryName": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "website": { "type": "string", "maxLength": 1000 },
        "logo": { "type": "string", "maxLength": 1000 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 5000 },
        "scholarshipCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "slug", "countryName"]
    },
    "Organization": {
      "title": "Organization",
      "description": "Sponsoring foundation or government organization",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 200 },
        "slug": { "type": "string", "maxLength": 200 },
        "type": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 5000 },
        "website": { "type": "string", "maxLength": 1000 },
        "logo": { "type": "string", "maxLength": 1000 },
        "country": { "type": "string", "maxLength": 100 },
        "verified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["name", "slug", "type"]
    },
    "Country": {
      "title": "Country",
      "description": "Study destination country",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 10 },
        "flag": { "type": "string", "maxLength": 200 },
        "coverImage": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 2000 },
        "popularFields": { "type": "array" },
        "scholarshipCount": { "type": "number" }
      },
      "required": ["name", "code"]
    },
    "User": {
      "title": "User",
      "description": "Student user or administrator profile",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "photoURL": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "maxLength": 50 },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["uid", "email", "role"]
    },
    "SavedScholarship": {
      "title": "SavedScholarship",
      "description": "User bookmarked scholarship relation",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "scholarshipId": { "type": "string", "maxLength": 128 },
        "savedAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["userId", "scholarshipId"]
    },
    "StudentReport": {
      "title": "StudentReport",
      "description": "Student flag report for listing verification",
      "type": "object",
      "properties": {
        "scholarshipId": { "type": "string", "maxLength": 128 },
        "scholarshipTitle": { "type": "string", "maxLength": 200 },
        "reason": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 2000 },
        "reporterEmail": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "maxLength": 50 }
      },
      "required": ["scholarshipId", "reason", "message"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configurations and disclaimers",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100 },
        "tagline": { "type": "string", "maxLength": 200 },
        "applicationDisclaimer": { "type": "string", "maxLength": 2000 }
      }
    }
  },
  "firestore": {
    "/scholarships/{scholarshipId}": {
      "schema": "Scholarship",
      "description": "Collection of all scholarship listings"
    },
    "/universities/{universityId}": {
      "schema": "University",
      "description": "Collection of universities"
    },
    "/organizations/{organizationId}": {
      "schema": "Organization",
      "description": "Collection of sponsoring organizations"
    },
    "/countries/{countryId}": {
      "schema": "Country",
      "description": "Collection of destination countries"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered user profile and role info"
    },
    "/users/{userId}/savedScholarships/{savedId}": {
      "schema": "SavedScholarship",
      "description": "User bookmarked scholarships"
    },
    "/reports/{reportId}": {
      "schema": "StudentReport",
      "description": "Student issue reports and flags"
    },
    "/siteSettings/{settingId}": {
      "schema": "SiteSettings",
      "description": "Site administration configuration document"
    }
  }
}
